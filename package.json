{
  "name": "dsh-session-cost-live",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "DSH plugin: live session cost in the composer dock — CNY/USD official pricing, peak/off-peak split, subagent roll-up, and an in-app price table editor.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cost",
    "pricing",
    "billing",
    "session",
    "token-usage",
    "subagent",
    "cny",
    "usd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiyijian/dsh-session-cost-live.git"
  },
  "homepage": "https://github.com/hiyijian/dsh-session-cost-live#readme",
  "bugs": {
    "url": "https://github.com/hiyijian/dsh-session-cost-live/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0",
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "tools/*.mjs",
    "test/*.mjs"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  }
}
